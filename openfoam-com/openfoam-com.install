# arg 1:  the new package version
post_install() {
  echo -e ""
  echo -e "\e[1m\e[31mNOTE:"
  echo -e " "
  echo -e "This install of OpenFOAM does NOT include the ThirdParty libraries;"
  echo -e "it uses the system's (kahip and petsc are not used)."
  echo -e ""
  echo -e "Please use \"of\" to load OpenFOAM (bash, from /etc/profile.d),"
  echo -e "before running paraFoam, which then uses OpenFOAM's reader plugins.\e[0m"
  echo -e ""
}

# arg 1:  the new package version
# arg 2:  the old package version
post_upgrade() {
  post_install $1
}
