# makepkg build artifacts
src/
pkg/
*.pkg.tar.*
*.log

# Downloaded sources
*.deb
*.tar.gz
*.tar.xz
*.tar.zst
*.zip
*.AppImage

# spotify: repository metadata fetched at build time
spotify/*-Release
spotify/*-Release.sig
spotify/*-Packages
spotify/*.sha256
spotify/*.sha512

# docker-credential-secretservice-bin: downloaded binary and license
docker-credential-secretservice-bin/docker-credential-secretservice-bin-*
docker-credential-secretservice-bin/LICENSE-*

# claude-code: downloaded binary, release manifest and legal notice
claude-code/claude-*
claude-code/claude-code-*-manifest.json*
claude-code/cc-legal-*

# claude-desktop: repository metadata fetched at build time
claude-desktop/*-Release
claude-desktop/*-Release.sig
claude-desktop/*-Packages
