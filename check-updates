#!/usr/bin/env bash
# Compare each package's pkgver with the latest upstream release.
#
# Usage: ./check-updates [package...]
# Exits 1 when an update is available, 2 when an upstream check failed.
set -uo pipefail

cd "$(dirname "$0")"

# shellcheck source=lib/packages.bash
source lib/packages.bash

if (($#)); then
  packages=("$@")
else
  packages=()
  for f in */PKGBUILD; do packages+=("${f%/PKGBUILD}"); done
fi

status=0
printf '%-40s %-20s %-20s %s\n' PACKAGE LOCAL UPSTREAM STATUS
for pkg in "${packages[@]}"; do
  if [[ ! -f $pkg/.SRCINFO ]]; then
    printf '%-40s %s\n' "$pkg" 'no .SRCINFO'
    status=2
    continue
  fi
  current=$(local_version "$pkg")

  if ! declare -F "upstream_$pkg" >/dev/null; then
    printf '%-40s %-20s %-20s %s\n' "$pkg" "$current" '?' 'no upstream check defined'
    status=2
    continue
  fi

  if ! latest=$("upstream_$pkg") || [[ -z $latest ]]; then
    printf '%-40s %-20s %-20s %s\n' "$pkg" "$current" '?' 'upstream check failed'
    status=2
    continue
  fi

  case $(vercmp "$latest" "$current") in
    1) state='UPDATE AVAILABLE'; ((status == 0)) && status=1 ;;
    0) state='up to date' ;;
    *) state='local is newer' ;;
  esac
  printf '%-40s %-20s %-20s %s\n' "$pkg" "$current" "$latest" "$state"
done

exit "$status"
