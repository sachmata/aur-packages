#!/usr/bin/env bash
# Compare each package's pkgver with the latest upstream release.
#
# Usage: ./check-updates [package...]
# Exits 1 when an update is available, 2 when an upstream check failed.
set -uo pipefail

cd "$(dirname "$0")"

fetch() { curl -fsSL --retry 2 --max-time 30 "$@"; }

# Highest Version: in a Debian Packages index
apt_latest() { fetch "$1" | awk '/^Version:/ { print $2 }' | sort -V | tail -n1; }

# Each upstream_<pkgname> prints the latest upstream version as [epoch:]pkgver
upstream_claude-code() {
  fetch https://downloads.claude.ai/claude-code-releases/latest
}

upstream_claude-desktop() {
  apt_latest https://downloads.claude.ai/claude-desktop/apt/stable/dists/stable/main/binary-amd64/Packages
}

upstream_docker-credential-secretservice-bin() {
  fetch https://api.github.com/repos/docker/docker-credential-helpers/releases/latest |
    jq -er '.tag_name | ltrimstr("v")'
}

upstream_spotify() {
  # Debian version 1:1.3.4.258.gc60b10b0946a -> 1:1.3.4.258 (the commit is _commit)
  apt_latest https://repository.spotify.com/dists/testing/non-free/binary-amd64/Packages |
    sed -E 's/\.g[0-9a-f]+$//'
}

local_version() {
  awk -F' = ' '
    $1 ~ /^\tepoch$/  { epoch = $2 }
    $1 ~ /^\tpkgver$/ { ver = $2 }
    END { print (epoch ? epoch ":" : "") ver }
  ' "$1/.SRCINFO"
}

if (($#)); then
  packages=("$@")
else
  packages=()
  for f in */PKGBUILD; do packages+=("${f%/PKGBUILD}"); done
fi

status=0
printf '%-40s %-20s %-20s %s\n' PACKAGE LOCAL UPSTREAM STATUS
for pkg in "${packages[@]}"; do
  if [[ ! -f $pkg/.SRCINFO ]]; then
    printf '%-40s %s\n' "$pkg" 'no .SRCINFO'
    status=2
    continue
  fi
  current=$(local_version "$pkg")

  if ! declare -F "upstream_$pkg" >/dev/null; then
    printf '%-40s %-20s %-20s %s\n' "$pkg" "$current" '?' 'no upstream check defined'
    status=2
    continue
  fi

  if ! latest=$("upstream_$pkg") || [[ -z $latest ]]; then
    printf '%-40s %-20s %-20s %s\n' "$pkg" "$current" '?' 'upstream check failed'
    status=2
    continue
  fi

  case $(vercmp "$latest" "$current") in
    1) state='UPDATE AVAILABLE'; ((status == 0)) && status=1 ;;
    0) state='up to date' ;;
    *) state='local is newer' ;;
  esac
  printf '%-40s %-20s %-20s %s\n' "$pkg" "$current" "$latest" "$state"
done

exit "$status"
