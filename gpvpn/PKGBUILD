# Maintainer: Martin Dimitrov <martin.dimitrov@chaos.com>

pkgname=gpvpn
pkgver=0.2.1
pkgrel=1
# Commit the v${pkgver} tag points to; prepare() checks the tag still matches
_commit=5b46e93e4e7815d9735adb7e449ea9d3f39222cf
pkgdesc="GlobalProtect VPN via stock openconnect with default-browser SAML login"
arch=('x86_64')
url="https://github.com/sachmata/gpvpn"
license=('MIT')
depends=('bash' 'coreutils' 'curl' 'glibc' 'iproute2' 'libxml2' 'openconnect'
         'polkit' 'sed' 'systemd' 'util-linux' 'xdg-utils')
makedepends=('git' 'odin')
optdepends=('libnotify: desktop notification when a login callback fails')
install=gpvpn.install
# Private repository, so ssh with the building user's key. Pinned by commit:
# the tag is unsigned and could be moved.
source=("git+ssh://git@github.com/sachmata/gpvpn.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
    cd gpvpn
    local tagged
    # makepkg's plain `git fetch` keeps a stale tag in a reused src/; force it
    # from the local mirror (origin), which makepkg has just updated
    git fetch -q --force origin "+refs/tags/v${pkgver}:refs/tags/v${pkgver}"
    tagged=$(git rev-parse --verify "refs/tags/v${pkgver}^{commit}")
    if [[ $tagged != "$_commit" ]]; then
        echo "tag v${pkgver} is ${tagged}, expected ${_commit}" >&2
        return 1
    fi
}

build() {
    cd gpvpn
    # makepkg reuses src/ across builds and make only tracks the .odin files,
    # so a stale binary from an earlier version would otherwise be packaged
    make clean all
}

check() {
    cd gpvpn
    make test
}

# Ships the static polkit rule with gpvpn@.service so pacman removes both
# together: the rule without the template would be passwordless root (see
# 50-gpvpn.rules). Operators and the portal list (/etc/gpvpn.conf) come from
# `sudo gpvpn setup-operator` after install (see gpvpn.install).
package() {
    cd gpvpn
    make DESTDIR="${pkgdir}" install-dist
}

