post_install() {
    cat <<'EOF'
==> Finish gpvpn setup (once per user):
    sudo gpvpn setup-operator --portal <portal-host> [user]
  then as that user (not with sudo):
    xdg-mime default gpvpn-callback.desktop x-scheme-handler/globalprotectcallback
    gpvpn doctor
EOF
}

post_remove() {
    cat <<'EOF'
==> setup-operator's files are left in place; remove them if unused:
    /etc/gpvpn.conf /etc/polkit-1/rules.d/50-gpvpn-*.rules
EOF
}
