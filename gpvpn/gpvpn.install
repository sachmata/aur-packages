post_install() {
    cat <<'EOF'
==> Finish gpvpn setup (once per user):
    sudo gpvpn setup-operator --server <gateway-host> [user]
  then as that user (not with sudo):
    xdg-mime default gpvpn-callback.desktop x-scheme-handler/globalprotectcallback
    gpvpn doctor
  on GNOME, after logging in again: gnome-extensions enable gpvpn@sachmata.github.io
EOF
}

post_remove() {
    cat <<'EOF'
==> Left in place: /etc/gpvpn.conf (gateway list) and the gpvpn group, which
    grants nothing now that the polkit rule is gone with the package.
EOF
}
