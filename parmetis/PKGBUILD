# Maintainer: envolution
# Contributor: Jed Brown <jed@59A2.org>
# Contributor: George Eleftheriou <eleftg>
# shellcheck shell=bash disable=SC2034,SC2154

pkgname=parmetis
pkgver=4.0.3+p7
_pkgver=${pkgver%%+*}
_debver=${pkgver/+p/-}
pkgrel=1
epoch=1
pkgdesc="A parallel graph partitioning library (debian patches)"
url="http://glaros.dtc.umn.edu/gkhome/metis/parmetis/overview"
#debian url=https://salsa.debian.org/science-team/parmetis
arch=('i686' 'x86_64')
license=(LicenseRef-custom)
depends=(openmpi metis gklib glibc)
makedepends=(cmake)

# The sources come from Debian's non-free pool; 4.0.3-7 is only in unstable.
# The signed suite Release lists Sources.xz, which lists the tarballs'
# checksums; prepare() checks that chain.
_dists=https://deb.debian.org/debian/dists/unstable
source=(
  https://deb.debian.org/debian/pool/non-free/p/parmetis/parmetis_${_pkgver}.orig.tar.gz
  https://deb.debian.org/debian/pool/non-free/p/parmetis/parmetis_${_debver}.debian.tar.xz
  "${pkgname}-${pkgver}-${pkgrel}-Release::${_dists}/Release"
  "${pkgname}-${pkgver}-${pkgrel}-Release.sig::${_dists}/Release.gpg"
  "${pkgname}-${pkgver}-${pkgrel}-Sources.xz::${_dists}/non-free/source/Sources.xz"
)
# Sources.xz is an index, not an archive
noextract=("${pkgname}-${pkgver}-${pkgrel}-Sources.xz")
# Release and Sources.xz change daily; the signature covers them
sha256sums=('f2d9a231b7cf97f1fee6e8c9663113ebf6c240d407d3c118c55b3633d6be6e5f'
            '0f2130dd5c6a7b2df5214b795eb51df2cc71c43e1194a117150297cec85b93b6'
            'SKIP'
            'SKIP'
            'SKIP')
# Debian archive automatic signing keys, both of which sign unstable's
# Release (fingerprints from https://ftp-master.debian.org/keys.html). When
# Debian adds the next release's key, vendor and add it here as well.
validpgpkeys=(
  'B8B80B5B623EAB6AD8775C45B7C5D7D6350947F8' # Debian Archive Automatic Signing Key (12/bookworm)
  '04B54C3CDCA79751B16BC6B5225629DF75B188BD' # Debian Archive Automatic Signing Key (13/trixie)
)

prepare() {
  local _release="${pkgname}-${pkgver}-${pkgrel}-Release"
  local _sources="${pkgname}-${pkgver}-${pkgrel}-Sources.xz"

  # Validate Sources.xz against the SHA256 section of the signed Release
  awk -v file="${_sources}" '
    /^[^ ]/ { section = $1 }
    section == "SHA256:" && $3 == "non-free/source/Sources.xz" { print $1 "  " file }
  ' "${_release}" > "${_sources}.sha256"
  [[ -s "${_sources}.sha256" ]] || { echo "Sources.xz not listed in Release" >&2; return 1; }
  sha256sum -c "${_sources}.sha256"

  # Validate the tarballs against the Checksums-Sha256 of the parmetis
  # ${_debver} entry in Sources. Once unstable moves past that version, the
  # entry is gone, but the tarballs are still checked by the pinned sha256sums.
  xz -dc "${_sources}" | awk -v ver="${_debver}" '
    BEGIN { RS = ""; FS = "\n" }
    $1 == "Package: parmetis" {
      found = 0
      for (i = 2; i <= NF; i++) if ($i == "Version: " ver) found = 1
      if (!found) next
      insums = 0
      for (i = 2; i <= NF; i++) {
        if ($i ~ /^[^ ]/) insums = ($i == "Checksums-Sha256:")
        else if (insums) { split(substr($i, 2), f, " "); print f[1] "  " f[3] }
      }
    }
  ' | grep -E "  parmetis_(${_pkgver}\.orig\.tar\.gz|${_debver}\.debian\.tar\.xz)\$" > "parmetis_${_debver}.sha256" || true
  if [[ $(wc -l < "parmetis_${_debver}.sha256") -ne 2 ]]; then
    printf "==> WARNING: %s\n" "Debian unstable no longer provides parmetis ${_debver}" >&2
    printf "==> WARNING: %s\n" "Skipping verification against the signed repository metadata" >&2
  else
    sha256sum -c "parmetis_${_debver}.sha256"
  fi

  cd ${pkgname}-${_pkgver}
  # Apply Debian patches using the series file
  if [[ -f "../debian/patches/series" ]]; then
    while read -r patch; do
      [[ -z $patch || $patch == \#* ]] && continue
      patch -Np1 <"../debian/patches/${patch}" || return 1
    done <"../debian/patches/series"
  else
    echo "Warning: patches/series file not found, skipping patching"
  fi

  # The system metis links GKlib separately, so libparmetis and the programs
  # need -lGKlib. CMAKE_C_STANDARD_LIBRARIES puts it at the end of the link
  # line (after the objects, so --as-needed keeps it), and unlike setting
  # CMAKE_*_LINKER_FLAGS it leaves makepkg's LDFLAGS in effect. The Makefile
  # pastes CONFIG_FLAGS unquoted into the cmake command, so no value may
  # contain spaces.
  _cmake_flags=(
    -DCMAKE_C_STANDARD_LIBRARIES=-lGKlib
    -DCMAKE_SKIP_RPATH=ON
  )
  sed -i "s|^CONFIG_FLAGS = .*|CONFIG_FLAGS = ${_cmake_flags[*]}|" Makefile
  sed -i 's|^cmake_minimum.*|cmake_minimum_required(VERSION 4.0)|' CMakeLists.txt
}
build() {
  cd ${pkgname}-${_pkgver}
  # Configure here, not in prepare(): makepkg exports CFLAGS and LDFLAGS
  # only to build() and later, and cmake reads them at configure time
  make config shared=1 prefix=/usr
  make
}

package() {
  cd ${pkgname}-${_pkgver}
  make install "DESTDIR=$pkgdir"
  install -Dm644 LICENSE.txt -t $pkgdir/usr/share/licenses/$pkgname
  install -Dm644 metis/LICENSE.txt $pkgdir/usr/share/licenses/$pkgname/metis-LICENSE.txt

}
